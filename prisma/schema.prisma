}

model OfflineTransaction {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  branchId            String?              @map("branch_id") @db.Uuid
  deviceId            String               @map("device_id")
  // [{ productId?, name, price, quantity, subtotal }] — transient sync buffer,
  // discarded once synced into a real Transaction; not reported on independently.
  items               Json
  subtotal            Decimal              @db.Decimal(12, 2)
  discountCode        String?              @map("discount_code")
  discountCategory    DiscountCategory?    @map("discount_category")
  discountAmount      Decimal?             @map("discount_amount") @db.Decimal(12, 2)
  taxExemptAmount     Decimal              @default(0) @map("tax_exempt_amount") @db.Decimal(12, 2)
  taxAmount           Decimal              @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  paymentMethod       OfflinePaymentMethod @map("payment_method")
  cashReceived        Decimal?             @map("cash_received") @db.Decimal(12, 2)
  change              Decimal?             @db.Decimal(12, 2)
  customerId          String?              @map("customer_id") @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  notes               String?
  offlineCreatedAt    DateTime             @default(now()) @map("offline_created_at")
  syncStatus          OfflineSyncStatus    @default(pending) @map("sync_status")
  syncedTransactionId String?              @map("synced_transaction_id") @db.Uuid
  retryCount          Int                  @default(0) @map("retry_count")
  syncError           String?              @map("sync_error")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?      @relation(fields: [branchId], references: [id])
  customer          Customer?    @relation(fields: [customerId], references: [id])
  user              User?        @relation(fields: [userId], references: [id])
  syncedTransaction Transaction? @relation("OfflineTransactionSynced", fields: [syncedTransactionId], references: [id])

  @@index([tenantId, syncStatus])
  @@index([tenantId, deviceId, offlineCreatedAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("offline_transactions")
}

model ZReading {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  branchId         String?  @map("branch_id") @db.Uuid
  businessDate     DateTime @map("business_date")
  beginningGT      Decimal  @map("beginning_gt") @db.Decimal(14, 2)
  endingGT         Decimal  @map("ending_gt") @db.Decimal(14, 2)
  grossSales       Decimal  @map("gross_sales") @db.Decimal(14, 2)
  vatableSales     Decimal  @default(0) @map("vatable_sales") @db.Decimal(14, 2)
  vatAmount        Decimal  @default(0) @map("vat_amount") @db.Decimal(14, 2)
  vatExemptSales   Decimal  @default(0) @map("vat_exempt_sales") @db.Decimal(14, 2)
  zeroRatedSales   Decimal  @default(0) @map("zero_rated_sales") @db.Decimal(14, 2)
  discountTotal    Decimal  @default(0) @map("discount_total") @db.Decimal(14, 2)
  transactionCount Int      @default(0) @map("transaction_count")
  voidCount        Int      @default(0) @map("void_count")
  generatedBy      String   @map("generated_by") @db.Uuid

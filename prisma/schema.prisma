// One subscription per tenant (tenantId is unique below).
model Subscription {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String             @unique @map("tenant_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  status                   SubscriptionStatus @default(trial)
  billingCycle             BillingCycle       @default(monthly) @map("billing_cycle")
  startDate                DateTime           @default(now()) @map("start_date")
  endDate                  DateTime?          @map("end_date")
  trialEndDate             DateTime?          @map("trial_end_date")
  nextBillingDate          DateTime?          @map("next_billing_date")
  lastBillingDate          DateTime?          @map("last_billing_date")
  cancelledAt              DateTime?          @map("cancelled_at")
  cancellationReason       String?            @map("cancellation_reason")
  suspendedAt              DateTime?          @map("suspended_at")
  pausedAt                 DateTime?          @map("paused_at")
  pauseReason              String?            @map("pause_reason")
  pauseEndsAt              DateTime?          @map("pause_ends_at")
  gracePeriodEndDate       DateTime?          @map("grace_period_end_date")
  trialConvertedAt         DateTime?          @map("trial_converted_at")
  paymentOverdue           Boolean            @default(false) @map("payment_overdue")
  outstandingBalance       Decimal            @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  lastInvoiceGeneratedAt   DateTime?          @map("last_invoice_generated_at")
  lateFeeAppliedAt         DateTime?          @map("late_fee_applied_at")
  reactivationFeeAppliedAt DateTime?          @map("reactivation_fee_applied_at")
  deactivatedAt            DateTime?          @map("deactivated_at")
  // { type, last4?, expiryMonth?, expiryYear?, provider? } — small, fixed-shape.
  paymentMethod            Json?              @map("payment_method")
  // { currentUsers, currentBranches, currentProducts, currentTransactions, lastResetDate } — single row, always overwritten together.
  usage                    Json               @default("{}")
  isTrial                  Boolean            @default(true) @map("is_trial")
  autoRenew                Boolean            @default(true) @map("auto_renew")
  isActive                 Boolean            @default(true) @map("is_active")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  billingHistory SubscriptionBillingHistoryEntry[]
  billingEvents  BillingEvent[]

  @@index([status])
  @@index([planId, status])
  @@index([tenantId, status, nextBillingDate])
  @@index([tenantId, isActive])
  @@map("subscriptions")
}

// Decomposed from Subscription.billingHistory[] — grows unboundedly over the
// subscription's lifetime (one entry per billing cycle, indefinitely).
model SubscriptionBillingHistoryEntry {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String               @map("subscription_id") @db.Uuid
  date           DateTime
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("PHP")
  status         BillingHistoryStatus
  transactionId  String?              @map("transaction_id")
  invoiceUrl     String?              @map("invoice_url")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, date(sort: Desc)])
  @@map("subscription_billing_history_entries")
}

model Attendance {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  clockIn    DateTime  @map("clock_in")
  clockOut   DateTime? @map("clock_out")
  breakStart DateTime? @map("break_start")
  breakEnd   DateTime? @map("break_end")
  totalHours Decimal?  @map("total_hours") @db.Decimal(6, 2)
  notes      String?
  // { latitude?, longitude?, address? } — small, fixed-shape.
  location   Json?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, clockIn(sort: Desc)])
  @@index([tenantId, clockIn(sort: Desc)])
  @@index([tenantId, isActive])
  @@map("attendances")
}

// ─── Undocumented models found outside models/ (not in the original 39-model
// inventory) — added after a follow-up audit. See lib/receipt.ts,
// lib/token-blacklist.ts, app/api/pos/session/[sessionId]/route.ts. ─────────

enum PosSessionPaymentStatus {
  pending
  processing
  completed
  failed

  @@map("pos_session_payment_status")
}

// Atomic per-key sequence generator (e.g. "REC-20260802-<tenantId>") backing
// BIR-compliant sequential receipt/invoice numbering. Increment via a single
// raw-SQL upsert (INSERT ... ON CONFLICT DO UPDATE SET seq = seq + 1
// RETURNING seq) — Prisma has no atomic increment-and-return primitive, and
// a read-then-write would race under concurrent checkouts.
model Counter {
  counterKey String @id @map("counter_key")
  seq        Int    @default(0)

  @@map("counters")
}

// No TTL in Postgres — a scheduled cleanup job must purge expired rows
// explicitly (Mongo relied on `expireAfterSeconds: 0` TTL indexes here).
model RevokedToken {
  tokenHash String   @id @map("token_hash")
  reason    String   @default("logout")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model UserRevocation {
  userId        String   @id @map("user_id") @db.Uuid
  revokedBefore DateTime @map("revoked_before")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_revocations")
}

// Ephemeral in-progress cart cache (1hr TTL in Mongo, no TTL in Postgres —
// needs an explicit cleanup job). `tenant` is a loose string, not a real FK,
// matching the original schema's untyped field.
model PosSession {
  sessionId     String                  @id @map("session_id")
  tenant        String
  // Array of cart line items — shape owned by the POS frontend, not modeled relationally.
  cart          Json                    @default("[]")
  subtotal      Decimal                 @default(0) @db.Decimal(12, 2)
  discount      Json?
  taxAmount     Decimal?                @map("tax_amount") @db.Decimal(12, 2)
  taxRate       Decimal?                @map("tax_rate") @db.Decimal(6, 3)
  taxLabel      String?                 @map("tax_label")
  tip           Decimal                 @default(0) @db.Decimal(12, 2)
  total         Decimal                 @default(0) @db.Decimal(12, 2)
  paymentMethod String?                 @map("payment_method")
  paymentStatus PosSessionPaymentStatus @default(pending) @map("payment_status")
  lastUpdate    DateTime                @default(now()) @map("last_update")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@map("pos_sessions")
}

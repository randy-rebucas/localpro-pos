// Phase 2 (foundation/reference tables) of the MongoDB -> PostgreSQL migration.
// See C:\Users\corew\.claude\plans\lets-migrate-the-database-tingly-quasar.md for the full plan.
//
// Fields that reference a model not yet migrated (User, Category, Product) are
// plain String @db.Uuid columns for now, with an index but no @relation — the
// @relation gets added once that model lands in a later phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


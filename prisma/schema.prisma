/// Booking.pre('save') overlap-prevention hook -> modeled as a Postgres
/// EXCLUDE USING gist constraint. Applied (and verified working against a
/// live database) in prisma/migrations/20260918120000_raw_sql_constraints/:
///   CREATE EXTENSION IF NOT EXISTS btree_gist;
///   ALTER TABLE bookings ADD CONSTRAINT bookings_no_staff_overlap
///     EXCLUDE USING gist (
///       "tenantId" WITH =,
///       "staffId" WITH =,
///       tsrange("startTime", "endTime") WITH &&
///     ) WHERE (status IN ('pending', 'confirmed') AND "staffId" IS NOT NULL);
/// Uses tsrange, not tstzrange: startTime/endTime are `timestamp without time
/// zone`, and tstzrange's implicit tz-aware cast is not IMMUTABLE, which
/// Postgres rejects in an exclusion-constraint expression.
model Booking {
  id                 String        @id
  tenantId           String
  customerName       String
  customerEmail      String?
  customerPhone      String?
  serviceName        String
  serviceDescription String?
  startTime          DateTime
  endTime            DateTime
  duration           Int
  status             BookingStatus @default(pending)
  staffId            String?
  staffName          String?
  notes              String?
  reminderSent       Boolean       @default(false)
  confirmationSent   Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  User?  @relation("BookingStaff", fields: [staffId], references: [id])

  @@index([tenantId, startTime])
  @@index([tenantId, staffId, startTime])
  @@index([startTime, endTime])
  @@index([tenantId, status, createdAt])
  @@map("bookings")
}

// ----------------------------------------------------------------------------
// Transactions (the core POS sale record)
// ----------------------------------------------------------------------------

model Transaction {
  id       String  @id
  tenantId String
  branchId String?

  subtotal         Decimal           @db.Decimal(18, 2)
  discountCode     String?
  discountCategory DiscountCategory?
  discountAmount   Decimal?          @db.Decimal(18, 2)
  scPwdName        String?
  scPwdId          String?
  taxExemptAmount  Decimal           @default(0) @db.Decimal(18, 2)
  zeroRatedAmount  Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal           @default(0) @db.Decimal(18, 2)
  total            Decimal           @db.Decimal(18, 2)

  paymentMethod    PaymentMethodType
  paymentProvider  String?
  paymentReference String?
  bnplInstallments Int?
  cashReceived     Decimal?          @db.Decimal(18, 2)
  change           Decimal?          @db.Decimal(18, 2)

  status                TransactionStatus @default(completed)
  customerId            String?
  loyaltyPointsEarned   Decimal?          @db.Decimal(18, 2)
  loyaltyPointsRedeemed Decimal?          @db.Decimal(18, 2)
  userId                String?
  deviceId              String?
  terminalId            String?
  deviceSerialNumber    String?
  receiptNumber         String?
  idempotencyKey        String?
  notes                 String?
  displayCurrency       String?
  displayTotal          Decimal?          @db.Decimal(18, 2)

  orderType   OrderType?
  tableNumber String?
  tableId     String?

  splitCount Int?

  salesChannel         SalesChannel?
  externalOrderId      String?
  channelSyncKey       String?
  channelImportedAt    DateTime?
  shopifyFulfilledAt   DateTime?
  shopifyFulfillmentId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User?     @relation("TransactionUser", fields: [userId], references: [id])
  device   Device?   @relation(fields: [deviceId], references: [id])
  table    PosTable? @relation("TransactionTable", fields: [tableId], references: [id])

  items                      TransactionItem[]
  splitPayments              TransactionSplitPayment[]
  payments                   Payment[]
  invoices                   Invoice[]
  loyaltyTransactions        LoyaltyTransaction[]
  offlineTransactionsSynced  OfflineTransaction[]
  prescriptions              Prescription[]
  prescriptionItemsDispensed PrescriptionItem[]
  stockMovements             StockMovement[]
  tablesCurrentOrder         PosTable[]                @relation("TableCurrentOrder")

  @@unique([tenantId, receiptNumber])
  // idempotencyKey / channelSyncKey are legacy Mongo *partial* unique indexes
  // (only enforced when the field is a non-empty string). Prisma's `@@unique`
  // always enforces across NULLs-excluded rows the same way Postgres does by
  // default (NULL != NULL), which already matches this semantics for a
  // nullable column — so a plain @@unique is sufficient here, no raw SQL
  // partial index needed (unlike the boolean-flag partial-unique cases like
  // cash_drawer_sessions.status = 'open', which DOES need raw SQL because the
  // "only when true" condition isn't NULL-based).
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, channelSyncKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, isActive, createdAt])
  @@map("transactions")
}


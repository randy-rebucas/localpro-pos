// ----------------------------------------------------------------------------
// Tenant + tenant settings cluster
// (Tenant.settings and its nested Maps/arrays -> dedicated tables. The single
// nested-object blocks with a fixed, small, predictable shape — address,
// numberFormat, businessPermits, restaurant/retail/laundry/pharmacy
// compliance, notificationTemplates, advancedBranding minus its Map,
// hardwareConfig, multiCurrency scalar fields, attendanceNotifications — are
// flattened into nullable columns on tenant_settings rather than exploded
// into their own 1:1 tables, since they are not arrays/subdocuments and a
// 1:1 table would add joins with no relational benefit.)
// ----------------------------------------------------------------------------

model Tenant {
  id                         String           @id
  slug                       String           @unique
  name                       String
  domain                     String?          @unique
  subdomain                  String?          @unique
  isActive                   Boolean          @default(true)
  onboardingStatus           OnboardingStatus @default(not_started)
  notes                      String?
  createdById                String?
  grandTotalSales            Decimal          @default(0) @db.Decimal(18, 2)
  grandTotalTransactionCount Int              @default(0)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  createdBy User? @relation("TenantCreatedBy", fields: [createdById], references: [id])

  settings                  TenantSettings?
  practitionerLicenses      TenantPractitionerLicense[]
  exchangeRates             TenantExchangeRate[]
  themeVariables            TenantThemeVariable[]
  receiptTemplates          TenantReceiptTemplate[]
  businessHours             TenantBusinessHour[]
  specialHours              TenantSpecialHours[]
  holidays                  TenantHoliday[]
  taxRules                  TaxRule[]
  users                     User[]
  branches                  Branch[]
  addresses                 Address[]
  devices                   Device[]
  categories                Category[]
  products                  Product[]
  productBundles            ProductBundle[]
  productChannelListings    ProductChannelListing[]
  ecommerceIntegrations     TenantEcommerceIntegration[]
  customers                 Customer[]
  customerOTPs              CustomerOTP[]
  customerBalancePayments   CustomerBalancePayment[]
  campaigns                 Campaign[]
  cashDrawerSessions        CashDrawerSession[]
  discounts                 Discount[]
  expenses                  Expense[]
  featureFlagOverrides      FeatureFlagOverride[]
  files                     File[]
  invoices                  Invoice[]
  loyaltyConfig             LoyaltyConfig?
  loyaltyTransactions       LoyaltyTransaction[]
  offlineTransactions       OfflineTransaction[]
  payments                  Payment[]
  prescriptions             Prescription[]
  recurringBookingTemplates RecurringBookingTemplate[]
  savedCarts                SavedCart[]
  stockMovements            StockMovement[]
  subscription              Subscription?
  posTables                 PosTable[]
  zReadings                 ZReading[]
  auditLogs                 AuditLog[]
  archivedAuditLogs         ArchivedAuditLog[]
  billingEvents             BillingEvent[]
  attendances               Attendance[]
  bookings                  Booking[]
  transactions              Transaction[]
  counters                  Counter[]

  dailySalesSummaries   DailySalesSummary[]
  monthlySalesSummaries MonthlySalesSummary[]
  productSalesSummaries ProductSalesSummary[]
  branchSalesSummaries  BranchSalesSummary[]
  cashierSalesSummaries CashierSalesSummary[]

  @@map("tenants")
}

model TenantSettings {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Currency & localization
  currency           String  @default("USD")
  currencySymbol     String?
  currencyPosition   String  @default("before") // 'before' | 'after'
  dateFormat         String  @default("MM/DD/YYYY")
  timeFormat         String  @default("12h") // '12h' | '24h'
  timezone           String  @default("Asia/Manila")
  language           String  @default("en") // 'en' | 'es'
  decimalSeparator   String  @default(".")
  thousandsSeparator String  @default(",")
  decimalPlaces      Int     @default(2)

  // Branding
  companyName     String?
  logo            String?
  favicon         String?
  primaryColor    String? @default("#35979c")
  secondaryColor  String?
  accentColor     String?
  backgroundColor String?
  textColor       String?

  // Contact info
  email          String?
  phone          String?
  addressStreet  String?
  addressCity    String?
  addressState   String?
  addressZipCode String?
  addressCountry String?
  website        String?

  // Receipt & invoice
  receiptHeader            String?
  receiptFooter            String?
  receiptShowLogo          Boolean @default(true)
  receiptShowAddress       Boolean @default(true)
  receiptShowPhone         Boolean @default(false)
  receiptShowEmail         Boolean @default(false)
  receiptDefaultTemplateId String?
  taxEnabled               Boolean @default(false)
  taxRate                  Decimal @default(0) @db.Decimal(5, 2)
  taxLabel                 String  @default("Tax")

  // Business
  businessType       String?
  taxId              String?
  registrationNumber String?

  // BIR compliance
  birTin                     String?
  birPtuNumber               String?
  birPtuIssuedDate           DateTime?
  birPtuExpiryDate           DateTime?
  birMinNumber               String?
  birBusinessStyle           String?
  birSystemProvider          String?
  birTerminalSN              String?
  birAccreditationNo         String?
  birAccreditationDate       DateTime?
  birAccreditationValidUntil DateTime?
  birEsalesPushUrl           String?

  // Business permits (single nested object, flattened)
  mayorsPermitNumber              String?
  mayorsPermitExpiry              DateTime?
  barangayClearanceNumber         String?
  barangayClearanceExpiry         DateTime?
  dtiSecRegistration              String?
  birCertificateOfRegistration    String?
  fireSafetyInspectionCertificate String?
  fsicExpiry                      DateTime?
  sanitaryPermitNumber            String?
  sanitaryPermitExpiry            DateTime?

  // Restaurant compliance (RA 10611)
  fdaFoodBusinessLicense      String?
  fdaFblExpiry                DateTime?
  foodSafetyCertificateNumber String?
  foodSafetyCertificateExpiry DateTime?
  foodHandlersCertified       Boolean   @default(false)
  numberOfCertifiedHandlers   Int?
  healthCertificateExpiry     DateTime?
  kitchenSanitationCompliant  Boolean   @default(false)

  // Retail compliance (RA 7394)
  dtiBusinessNameRegistration String?
  priceTaggingCompliant       Boolean @default(false)
  weightsAndMeasuresCompliant Boolean @default(false)
  btiAccreditation            String?
  productLabelsCompliant      Boolean @default(false)

  // Laundry compliance (DENR/EMB)
  environmentalComplianceCertificate String?
  eccExpiry                          DateTime?
  wastewaterDischargePermit          String?
  wastewaterPermitExpiry             DateTime?
  solidWasteManagementPlan           Boolean   @default(false)

  // Service business compliance (DOH/LGU) — practitionerLicenses[] -> own table
  serviceDohAccreditation       String?
  serviceDohAccreditationExpiry DateTime?

  // Pharmacy compliance
  pharmacistName           String?
  pharmacistPRCNumber      String?
  pharmacistPTRNumber      String?
  fdaLTO                   String?
  fdaLTOExpiryDate         DateTime?
  pharmacyDohAccreditation String?
  pdeaLicense              String?
  pdeaLicenseExpiry        DateTime?
  requirePrescriptionForRx Boolean   @default(true)
  trackExpiryDates         Boolean   @default(true)
  expiryAlertDays          Int       @default(90)

  // Notifications
  lowStockThreshold                 Int     @default(10)
  lowStockAlert                     Boolean @default(true)
  emailNotifications                Boolean @default(false)
  smsNotifications                  Boolean @default(false)
  attendanceNotificationsEnabled    Boolean @default(true)
  attendanceExpectedStartTime       String  @default("09:00")
  attendanceMaxHoursWithoutClockOut Int     @default(12)

  // Feature flags
  enableInventory             Boolean @default(true)
  enableCategories            Boolean @default(true)
  enableDiscounts             Boolean @default(false)
  enableLoyaltyProgram        Boolean @default(false)
  enableCustomerManagement    Boolean @default(false)
  enableOnAccountSales        Boolean @default(false)
  autoOpenDrawerOnShiftStart  Boolean @default(false)
  autoOpenDrawerOnShiftEnd    Boolean @default(false)
  enableBookingScheduling     Boolean @default(false)
  enableTableManagement       Boolean @default(false)
  ecommerceShopifyEnabled     Boolean @default(false)
  ecommerceWooCommerceEnabled Boolean @default(false)

  // Hardware config (single nested object)
  printerType                  String?
  printerProfile               String?
  printerVendorId              Int?
  printerProductId             Int?
  printerIpAddress             String?
  printerPortNumber            Int?
  barcodeScannerType           String?
  barcodeScannerEnabled        Boolean?
  qrReaderEnabled              Boolean?
  qrReaderCameraId             String?
  cashDrawerEnabled            Boolean?
  cashDrawerConnectedToPrinter Boolean?
  touchscreenEnabled           Boolean?

  // Multi-currency (scalar fields; exchangeRates Map -> TenantExchangeRate; displayCurrencies -> native array)
  multiCurrencyEnabled    Boolean   @default(false)
  displayCurrencies       String[]
  exchangeRateSource      String    @default("manual") // 'manual' | 'api'
  exchangeRateApiKey      String?
  exchangeRateLastUpdated DateTime?

  // Notification templates (single nested object per channel, flattened)
  emailBookingConfirmationTemplate String?
  emailBookingReminderTemplate     String?
  emailBookingCancellationTemplate String?
  emailLowStockAlertTemplate       String?
  emailAttendanceAlertTemplate     String?
  smsBookingConfirmationTemplate   String?
  smsBookingReminderTemplate       String?
  smsBookingCancellationTemplate   String?
  smsLowStockAlertTemplate         String?

  // Advanced branding (customTheme.variables Map -> TenantThemeVariable)
  fontFamily         String?
  fontSource         String  @default("system") // 'google' | 'custom' | 'system'
  googleFontUrl      String?
  customFontUrl      String?
  theme              String  @default("light") // 'light' | 'dark' | 'auto' | 'custom'
  customThemeCss     String?
  borderRadius       String  @default("md")
  customBorderRadius String?

  // Business hours (businessHours.timezone kept here; schedule Map -> TenantBusinessHour)
  businessHoursTimezone String?

  updatedAt DateTime @updatedAt

  @@map("tenant_settings")
}

/// rolePermissionOverrides is Schema.Types.Mixed keyed by arbitrary role ->
/// permission-key -> boolean. The key set is not fixed (new permission keys
/// are added as features ship) so this is one of the few deliberate JSONB
/// uses called out in the report rather than normalized.
model TenantRolePermissionOverride {
  tenantId  String
  overrides Json
  updatedAt DateTime @updatedAt

  @@id([tenantId])
  @@map("tenant_role_permission_overrides")
}

model TenantPractitionerLicense {
  id            String    @id
  tenantId      String
  name          String?
  licenseType   String?
  prcNumber     String?
  ptrNumber     String?
  licenseExpiry DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_practitioner_licenses")
}

model TenantExchangeRate {
  id           String  @id
  tenantId     String
  currencyCode String
  rate         Decimal @db.Decimal(18, 6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currencyCode])
  @@map("tenant_exchange_rates")
}

model TenantThemeVariable {
  id       String @id
  tenantId String
  name     String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("tenant_theme_variables")
}

model TenantReceiptTemplate {
  id        String   @id
  tenantId  String
  name      String
  html      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_receipt_templates")
}

model TenantBusinessHour {
  id        String  @id
  tenantId  String
  dayOfWeek Int // 0=Sun..6=Sat (Mongoose Map key)
  enabled   Boolean @default(true)
  openTime  String?
  closeTime String?

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  breaks TenantBusinessHourBreak[]

  @@unique([tenantId, dayOfWeek])
  @@map("tenant_business_hours")
}

model TenantBusinessHourBreak {
  id             String @id
  businessHourId String
  start          String
  end            String

  businessHour TenantBusinessHour @relation(fields: [businessHourId], references: [id], onDelete: Cascade)

  @@index([businessHourId])
  @@map("tenant_business_hour_breaks")
}

model TenantSpecialHours {
  id        String  @id
  tenantId  String
  date      String
  enabled   Boolean @default(true)
  openTime  String?
  closeTime String?
  note      String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("tenant_special_hours")
}

model TenantHoliday {
  id                  String   @id
  tenantId            String
  name                String
  date                String
  type                String   @default("single") // 'single' | 'recurring'
  recurringPattern    String? // 'yearly' | 'monthly' | 'weekly'
  recurringDayOfMonth Int?
  recurringDayOfWeek  Int?
  recurringMonth      Int?
  isBusinessClosed    Boolean  @default(true)
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_holidays")
}

// ----------------------------------------------------------------------------
// Users, addresses, branches, devices
// ----------------------------------------------------------------------------

model User {
  id        String    @id
  email     String    @unique
  password  String
  name      String
  role      UserRole  @default(cashier)
  tenantId  String?
  branchId  String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  qrToken   String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  tenantsCreated              Tenant[]                   @relation("TenantCreatedBy")
  addresses                   Address[]
  branchesManaged             Branch[]                   @relation("BranchManager")
  devicesRegistered           Device[]                   @relation("DeviceRegisteredBy")
  customerBalancePayments     CustomerBalancePayment[]
  campaigns                   Campaign[]
  cashDrawerSessions          CashDrawerSession[]
  expenses                    Expense[]
  filesUploaded               File[]
  loyaltyTransactionsCreated  LoyaltyTransaction[]
  offlineTransactions         OfflineTransaction[]
  paymentsProcessed           Payment[]
  prescriptionsCreated        Prescription[]
  prescriptionItemsDispensed  PrescriptionItem[]
  savedCarts                  SavedCart[]
  stockMovements              StockMovement[]
  posTablesCurrentOrderUser   Transaction[]              @relation("TransactionUser")
  zReadingsGenerated          ZReading[]
  auditLogs                   AuditLog[]
  archivedAuditLogs           ArchivedAuditLog[]
  superAdminActions           SuperAdminAction[]
  billingEventsRecorded       BillingEvent[]
  attendances                 Attendance[]
  bookingsStaff               Booking[]                  @relation("BookingStaff")
  recurringBookingTemplates   RecurringBookingTemplate[] @relation("RecurringBookingStaff")
  couponsCreated              Coupon[]
  featureFlagOverridesGranted FeatureFlagOverride[]
  systemSettingsUpdated       SystemSettings[]

  cashierSalesSummaries CashierSalesSummary[]

  @@index([tenantId, role, isActive])
  @@index([tenantId, branchId, isActive])
  @@map("users")
}

model Address {
  id        String   @id
  userId    String
  tenantId  String
  label     String   @default("Home")
  street    String
  city      String
  state     String?
  zipCode   String?
  country   String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId])
  @@map("addresses")
}

model Branch {
  id        String   @id
  tenantId  String
  name      String
  code      String?
  street    String?
  city      String?
  state     String?
  zipCode   String?
  country   String?
  phone     String?
  email     String?
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  manager User?  @relation("BranchManager", fields: [managerId], references: [id])

  users                        User[]
  devices                      Device[]
  offlineTransactions          OfflineTransaction[]
  posTables                    PosTable[]
  stockMovements               StockMovement[]
  zReadings                    ZReading[]
  transactions                 Transaction[]
  ecommerceIntegrationsDefault TenantEcommerceIntegration[]

  dailySalesSummaries   DailySalesSummary[]
  monthlySalesSummaries MonthlySalesSummary[]
  productSalesSummaries ProductSalesSummary[]
  branchSalesSummaries  BranchSalesSummary[]
  cashierSalesSummaries CashierSalesSummary[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("branches")
}

model Device {
  id             String    @id
  tenantId       String
  branchId       String
  label          String
  serialNumber   String
  terminalId     String
  ptuNumber      String?
  ptuStatus      PtuStatus @default(pending)
  isActive       Boolean   @default(true)
  registeredById String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  branch       Branch @relation(fields: [branchId], references: [id])
  registeredBy User   @relation("DeviceRegisteredBy", fields: [registeredById], references: [id])

  transactions Transaction[]

  @@unique([tenantId, terminalId])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, isActive])
  @@map("devices")
}

// ----------------------------------------------------------------------------
// Catalog: categories, products (+ variations/branchStock/modifiers/industry
// detail tables), bundles, channel listings
// ----------------------------------------------------------------------------

model Category {
  id          String   @id
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  products       Product[]
  productBundles ProductBundle[]
  taxRules       TaxRuleCategory[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Product {
  id                   String      @id
  tenantId             String
  name                 String
  description          String?
  price                Decimal     @db.Decimal(18, 2)
  stock                Int         @default(0)
  sku                  String?
  barcode              String?
  category             String? // legacy free-text category label kept alongside categoryId FK
  categoryId           String?
  image                String?
  productType          ProductType @default(regular)
  hasVariations        Boolean     @default(false)
  taxExempt            Boolean     @default(false)
  zeroRated            Boolean     @default(false)
  trackInventory       Boolean     @default(true)
  allowOutOfStockSales Boolean     @default(false)
  lowStockThreshold    Int?
  pinned               Boolean     @default(false)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  variations              ProductVariation[]
  branchStock             ProductBranchStock[]
  modifiers               ProductModifier[]
  restaurantDetails       ProductRestaurantDetails?
  laundryDetails          ProductLaundryDetails?
  serviceDetails          ProductServiceDetails?
  pharmacyDetails         ProductPharmacyDetails?
  channelListings         ProductChannelListing[]
  transactionItems        TransactionItem[]
  offlineTransactionItems OfflineTransactionItem[]
  savedCartItems          SavedCartItem[]
  stockMovements          StockMovement[]
  bundleItems             ProductBundleItem[]
  prescriptionItems       PrescriptionItem[]
  taxRules                TaxRuleProduct[]
  salesSummaries          ProductSalesSummary[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productType, trackInventory])
  @@index([tenantId, hasVariations])
  @@index([tenantId, pinned, createdAt])
  @@map("products")
}

model ProductVariation {
  id        String   @id
  productId String
  size      String?
  color     String?
  type      String?
  sku       String?
  price     Decimal? @db.Decimal(18, 2)
  stock     Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  transactionItemVariationRef TransactionItem[] @relation("ItemVariation")

  @@index([productId])
  @@map("product_variations")
}

model ProductBranchStock {
  id        String @id
  productId String
  branchId  String
  stock     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@map("product_branch_stock")
}

model ProductModifier {
  id        String  @id
  productId String
  name      String
  required  Boolean @default(false)

  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductModifierOption[]

  @@index([productId])
  @@map("product_modifiers")
}

model ProductModifierOption {
  id         String  @id
  modifierId String
  name       String
  price      Decimal @default(0) @db.Decimal(18, 2)

  modifier ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@index([modifierId])
  @@map("product_modifier_options")
}

model ProductRestaurantDetails {
  productId String   @id
  allergens String[]
  calories  Int?
  protein   Decimal? @db.Decimal(8, 2)
  carbs     Decimal? @db.Decimal(8, 2)
  fat       Decimal? @db.Decimal(8, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_restaurant_details")
}

model ProductLaundryDetails {
  productId         String              @id
  serviceType       LaundryServiceType?
  weightBased       Boolean             @default(false)
  pickupDelivery    Boolean             @default(false)
  estimatedDuration Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_laundry_details")
}

model ProductServiceDetails {
  productId         String   @id
  serviceDuration   Int?
  staffRequired     Int      @default(1)
  equipmentRequired String[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_service_details")
}

model ProductPharmacyDetails {
  productId            String        @id
  genericName          String?
  manufacturer         String?
  prn                  String?
  batchNumber          String?
  expiryDate           DateTime?
  drugSchedule         DrugSchedule?
  requiresPrescription Boolean       @default(false)
  storageConditions    String?
  activeIngredient     String?
  dosageStrength       String?
  dosageForm           String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([drugSchedule])
  @@map("product_pharmacy_details")
}

model ProductBundle {
  id             String   @id
  tenantId       String
  name           String
  description    String?
  price          Decimal  @db.Decimal(18, 2)
  sku            String?
  categoryId     String?
  image          String?
  trackInventory Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  category Category?           @relation(fields: [categoryId], references: [id])
  items    ProductBundleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@map("product_bundles")
}

model ProductBundleItem {
  id             String  @id
  bundleId       String
  productId      String
  productName    String
  quantity       Int
  variationSize  String?
  variationColor String?
  variationType  String?

  bundle  ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([bundleId])
  @@index([productId])
  @@map("product_bundle_items")
}

model ProductChannelListing {
  id                String            @id
  tenantId          String
  productId         String
  provider          EcommerceProvider
  externalProductId String
  externalVariantId String
  inventoryItemId   String?
  sku               String?
  variationSize     String?
  variationColor    String?
  variationType     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, provider, externalVariantId])
  @@index([tenantId, productId, provider])
  @@map("product_channel_listings")
}

model TenantEcommerceIntegration {
  id                     String            @id
  tenantId               String
  provider               EcommerceProvider
  shopDomain             String?
  siteUrl                String?
  credentialsEncrypted   String
  webhookSecretEncrypted String?
  scopes                 String[]
  shopifyLocationId      String?
  isActive               Boolean           @default(true)
  lastSyncAt             DateTime?
  lastError              String?
  defaultBranchId        String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  defaultBranch Branch? @relation(fields: [defaultBranchId], references: [id])

  @@unique([tenantId, provider])
  @@index([shopDomain])
  @@index([siteUrl, tenantId])
  @@map("tenant_ecommerce_integrations")
}

// ----------------------------------------------------------------------------
// Customers
// ----------------------------------------------------------------------------

model Customer {
  id                   String    @id
  tenantId             String
  firstName            String
  lastName             String
  email                String?
  phone                String?
  dateOfBirth          DateTime?
  notes                String?
  tags                 String[]
  totalSpent           Decimal   @default(0) @db.Decimal(18, 2)
  lastPurchaseDate     DateTime?
  loyaltyPointsBalance Decimal   @default(0) @db.Decimal(18, 2)
  accountBalance       Decimal   @default(0) @db.Decimal(18, 2)
  creditLimit          Decimal?  @db.Decimal(18, 2)
  shopifyCustomerId    String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  addresses CustomerAddress[]

  balancePayments     CustomerBalancePayment[]
  invoices            Invoice[]
  loyaltyTransactions LoyaltyTransaction[]
  offlineTransactions OfflineTransaction[]
  transactions        Transaction[]

  @@unique([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, isActive])
  @@index([tenantId, shopifyCustomerId])
  @@index([tenantId, tags])
  @@map("customers")
}

model CustomerAddress {
  id         String  @id
  customerId String
  street     String?
  city       String?
  state      String?
  zipCode    String?
  country    String?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerOTP {
  id        String   @id
  tenantId  String
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, phone])
  @@index([tenantId, phone, verified])
  @@index([expiresAt]) // app-level / scheduled-job cleanup replaces Mongo TTL index — see report
  @@map("customer_otps")
}

model CustomerBalancePayment {
  id             String                       @id
  tenantId       String
  customerId     String
  amount         Decimal                      @db.Decimal(18, 2)
  method         CustomerBalancePaymentMethod
  notes          String?
  recordedById   String?
  idempotencyKey String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User?    @relation(fields: [recordedById], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, customerId, createdAt])
  @@map("customer_balance_payments")
}

// ----------------------------------------------------------------------------
// Marketing / coupons / subscriptions (super-admin scoped)
// ----------------------------------------------------------------------------

model Campaign {
  id          String          @id
  tenantId    String
  name        String
  channel     CampaignChannel
  segment     CampaignSegment
  subject     String?
  body        String
  status      CampaignStatus  @default(draft)
  sentCount   Int             @default(0)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("campaigns")
}

model Coupon {
  id            String          @id
  code          String          @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal         @db.Decimal(18, 2)
  appliesTo     CouponAppliesTo @default(all_plans)
  maxUses       Int?
  usedCount     Int             @default(0)
  validFrom     DateTime        @default(now())
  validUntil    DateTime?
  isActive      Boolean         @default(true)
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  createdBy User         @relation(fields: [createdById], references: [id])
  plans     CouponPlan[]

  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

/// planIds[] many-to-many join table (Coupon <-> SubscriptionPlan)
model CouponPlan {
  couponId String
  planId   String

  coupon Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@map("coupon_plans")
}

model SubscriptionPlan {
  id              String           @id
  name            String
  tier            SubscriptionTier @unique
  description     String?
  priceMonthly    Decimal          @db.Decimal(18, 2)
  priceSetupFee   Decimal          @default(0) @db.Decimal(18, 2)
  priceCurrency   String           @default("PHP")
  reactivationFee Decimal          @default(500) @db.Decimal(18, 2)

  // features (single fixed nested object -> flattened columns)
  maxUsers                  Int
  maxBranches               Int
  maxProducts               Int
  maxTransactions           Int
  enableInventory           Boolean @default(true)
  enableCategories          Boolean @default(true)
  enableDiscounts           Boolean @default(false)
  enableLoyaltyProgram      Boolean @default(false)
  enableCustomerManagement  Boolean @default(false)
  enableBookingScheduling   Boolean @default(false)
  enableTableManagement     Boolean @default(false)
  enableReports             Boolean @default(true)
  enableMultiBranch         Boolean @default(false)
  enableHardwareIntegration Boolean @default(false)
  prioritySupport           Boolean @default(false)
  customIntegrations        Boolean @default(false)
  dedicatedAccountManager   Boolean @default(false)

  // birCompliance (flattened)
  birPtuAssistance     Boolean @default(false)
  birReceiptFormatting Boolean @default(false)
  birDocumentation     Boolean @default(false)
  birCasReporting      Boolean @default(false)
  birAuditTrailSystem  Boolean @default(false)
  birMonthlySupport    Boolean @default(false)

  // pharmacyCompliance (flattened)
  pharmacyComplianceEnabled Boolean @default(false)
  prescriptionManagement    Boolean @default(false)
  expiryTracking            Boolean @default(false)
  pdeaReporting             Boolean @default(false)

  isActive              Boolean  @default(true)
  isCustom              Boolean  @default(false)
  availableToNewTenants Boolean  @default(true)
  yearlyDiscount        Decimal  @default(0) @db.Decimal(5, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  coupons       CouponPlan[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

model Subscription {
  id                       String             @id
  tenantId                 String             @unique
  planId                   String
  status                   SubscriptionStatus @default(trial)
  billingCycle             BillingCycle       @default(monthly)
  startDate                DateTime           @default(now())
  endDate                  DateTime?
  trialEndDate             DateTime?
  nextBillingDate          DateTime?
  lastBillingDate          DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  suspendedAt              DateTime?
  pausedAt                 DateTime?
  pauseReason              String?
  pauseEndsAt              DateTime?
  gracePeriodEndDate       DateTime?
  trialConvertedAt         DateTime?
  paymentOverdue           Boolean            @default(false)
  outstandingBalance       Decimal            @default(0) @db.Decimal(18, 2)
  lastInvoiceGeneratedAt   DateTime?
  lateFeeAppliedAt         DateTime?
  reactivationFeeAppliedAt DateTime?
  deactivatedAt            DateTime?

  // paymentMethod (single nested object -> flattened)
  paymentType        SubscriptionPaymentType?
  paymentLast4       String?
  paymentExpiryMonth Int?
  paymentExpiryYear  Int?
  paymentProvider    String?

  // usage (single nested object -> flattened)
  usageCurrentUsers        Int      @default(0)
  usageCurrentBranches     Int      @default(1)
  usageCurrentProducts     Int      @default(0)
  usageCurrentTransactions Int      @default(0)
  usageLastResetDate       DateTime @default(now())

  isTrial   Boolean  @default(true)
  autoRenew Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  billingHistory SubscriptionBillingHistory[]
  billingEvents  BillingEvent[]

  @@index([status])
  @@index([planId, status])
  @@index([tenantId, status, nextBillingDate])
  @@index([tenantId, isActive])
  @@map("subscriptions")
}

model SubscriptionBillingHistory {
  id             String               @id
  subscriptionId String
  date           DateTime
  amount         Decimal              @db.Decimal(18, 2)
  currency       String               @default("PHP")
  status         BillingHistoryStatus
  transactionId  String?
  invoiceUrl     String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, date])
  @@map("subscription_billing_history")
}

model SuperAdminAction {
  id          String   @id
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  description String?
  /// Mixed shape describing an arbitrary changeset for whichever entity type
  /// was targeted (tenant, user, plan, ...) — not fixed enough to normalize.
  changes     Json?
  ipAddress   String?
  userAgent   String?
  /// Arbitrary per-action metadata blob — deliberate JSONB (see report).
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("super_admin_actions")
}

model BillingEvent {
  id             String           @id
  tenantId       String
  subscriptionId String
  type           BillingEventType
  amount         Decimal          @db.Decimal(18, 2)
  currency       String           @default("PHP")
  description    String?
  notes          String?
  transactionId  String?
  invoiceUrl     String?
  recordedById   String?
  /// Arbitrary per-event metadata blob — deliberate JSONB (see report).
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  recordedBy   User?        @relation(fields: [recordedById], references: [id])

  @@unique([tenantId, transactionId])
  @@index([tenantId, createdAt])
  @@map("billing_events")
}

model FeatureFlagOverride {
  id          String    @id
  tenantId    String
  feature     String
  enabled     Boolean
  reason      String?
  expiresAt   DateTime?
  grantedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  grantedBy User   @relation(fields: [grantedById], references: [id])

  @@unique([tenantId, feature])
  @@index([expiresAt])
  @@map("feature_flag_overrides")
}

// Single-row table for platform-wide settings (maintenance mode, etc).
// Always accessed by the fixed id below rather than a query filter.
model SystemSettings {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  updatedById        String?
  updatedAt          DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

// ----------------------------------------------------------------------------
// Operations: cash drawer, expenses, files, invoices, loyalty, discounts,
// tax rules, prescriptions, tables, z-readings, stock movements, saved carts,
// recurring booking templates, bookings, attendance
// ----------------------------------------------------------------------------

model CashDrawerSession {
  id             String           @id
  tenantId       String
  userId         String
  openingAmount  Decimal          @db.Decimal(18, 2)
  closingAmount  Decimal?         @db.Decimal(18, 2)
  expectedAmount Decimal?         @db.Decimal(18, 2)
  shortage       Decimal?         @db.Decimal(18, 2)
  overage        Decimal?         @db.Decimal(18, 2)
  openingTime    DateTime         @default(now())
  closingTime    DateTime?
  status         CashDrawerStatus @default(open)
  notes          String?
  totalVAT       Decimal          @default(0) @db.Decimal(18, 2)
  totalDiscounts Decimal          @default(0) @db.Decimal(18, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, openingTime])
  // Only one OPEN session per tenant — Postgres partial unique index, applied
  // via raw SQL in prisma/migrations/20260918120000_raw_sql_constraints/
  // (Prisma's schema DSL can't express partial indexes directly).
  @@map("cash_drawer_sessions")
}

model Discount {
  id                     String           @id
  tenantId               String
  code                   String
  name                   String?
  description            String?
  type                   DiscountType
  value                  Decimal          @db.Decimal(18, 2)
  category               DiscountCategory @default(general)
  requiresIdVerification Boolean          @default(false)
  minPurchaseAmount      Decimal?         @db.Decimal(18, 2)
  maxDiscountAmount      Decimal?         @db.Decimal(18, 2)
  validFrom              DateTime
  validUntil             DateTime
  usageLimit             Int?
  usageCount             Int              @default(0)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, isActive, validFrom, validUntil])
  @@map("discounts")
}

model Expense {
  id            String               @id
  tenantId      String
  name          String
  description   String
  amount        Decimal              @db.Decimal(18, 2)
  date          DateTime             @default(now())
  paymentMethod ExpensePaymentMethod
  receipt       String?
  notes         String?
  userId        String
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, date])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@map("expenses")
}

model File {
  id           String   @id
  tenantId     String
  name         String
  filename     String
  size         Int
  type         String
  url          String
  uploadedById String
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, uploadedAt])
  @@map("files")
}

model Invoice {
  id            String  @id
  tenantId      String
  invoiceNumber String
  transactionId String?
  customerId    String?

  // customerInfo (point-in-time snapshot, not a live relation -> flattened)
  snapshotName           String?
  snapshotEmail          String?
  snapshotPhone          String?
  snapshotAddressStreet  String?
  snapshotAddressCity    String?
  snapshotAddressState   String?
  snapshotAddressZipCode String?
  snapshotAddressCountry String?

  subtotal       Decimal       @db.Decimal(18, 2)
  discountAmount Decimal?      @db.Decimal(18, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @db.Decimal(18, 2)
  dueDate        DateTime
  paymentTerms   String?
  status         InvoiceStatus @default(draft)
  paidAt         DateTime?
  paidAmount     Decimal?      @db.Decimal(18, 2)
  notes          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  transaction Transaction?  @relation(fields: [transactionId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, transactionId])
  @@index([tenantId, isActive])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id
  invoiceId   String
  name        String
  description String?
  quantity    Int
  price       Decimal @db.Decimal(18, 2)
  subtotal    Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model LoyaltyConfig {
  tenantId      String   @id
  pointsPerPeso Decimal  @default(1) @db.Decimal(10, 4)
  pesoPerPoint  Decimal  @default(0.10) @db.Decimal(10, 4)
  minRedemption Int      @default(100)
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("loyalty_configs")
}

model LoyaltyTransaction {
  id            String                 @id
  tenantId      String
  customerId    String
  transactionId String?
  type          LoyaltyTransactionType
  points        Decimal                @db.Decimal(18, 2)
  balanceBefore Decimal                @db.Decimal(18, 2)
  balanceAfter  Decimal                @db.Decimal(18, 2)
  description   String
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  createdBy   User?        @relation(fields: [createdById], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, transactionId])
  @@map("loyalty_transactions")
}

model OfflineTransaction {
  id                  String            @id
  tenantId            String
  branchId            String?
  deviceId            String // opaque client-device identifier string, NOT a Device FK
  subtotal            Decimal           @db.Decimal(18, 2)
  discountCode        String?
  discountCategory    DiscountCategory?
  discountAmount      Decimal?          @db.Decimal(18, 2)
  taxExemptAmount     Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount           Decimal           @default(0) @db.Decimal(18, 2)
  total               Decimal           @db.Decimal(18, 2)
  paymentMethod       String // 'cash' | 'card' | 'digital'
  cashReceived        Decimal?          @db.Decimal(18, 2)
  change              Decimal?          @db.Decimal(18, 2)
  customerId          String?
  userId              String?
  notes               String?
  offlineCreatedAt    DateTime          @default(now())
  syncStatus          OfflineSyncStatus @default(pending)
  syncedTransactionId String?
  retryCount          Int               @default(0)
  syncError           String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  branch            Branch?                  @relation(fields: [branchId], references: [id])
  customer          Customer?                @relation(fields: [customerId], references: [id])
  user              User?                    @relation(fields: [userId], references: [id])
  syncedTransaction Transaction?             @relation(fields: [syncedTransactionId], references: [id])
  items             OfflineTransactionItem[]

  @@index([tenantId, syncStatus])
  @@index([tenantId, deviceId, offlineCreatedAt])
  @@index([tenantId, createdAt])
  @@map("offline_transactions")
}

model OfflineTransactionItem {
  id                   String  @id
  offlineTransactionId String
  productId            String?
  name                 String
  price                Decimal @db.Decimal(18, 2)
  quantity             Int
  subtotal             Decimal @db.Decimal(18, 2)

  offlineTransaction OfflineTransaction @relation(fields: [offlineTransactionId], references: [id], onDelete: Cascade)
  product            Product?           @relation(fields: [productId], references: [id])

  @@index([offlineTransactionId])
  @@map("offline_transaction_items")
}

model Payment {
  id            String              @id
  tenantId      String
  transactionId String
  method        PaymentMethodSimple
  amount        Decimal             @db.Decimal(18, 2)
  status        PaymentStatus       @default(pending)

  // details (single nested object -> flattened)
  detailsCardLast4    String?
  detailsCardType     String?
  detailsCardBrand    String?
  detailsGatewayTxnId String?
  detailsProvider     String?
  detailsCashReceived Decimal? @db.Decimal(18, 2)
  detailsChange       Decimal? @db.Decimal(18, 2)
  detailsCheckNumber  String?
  detailsNotes        String?

  processedById String?
  processedAt   DateTime?

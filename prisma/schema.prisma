/// Atomic sequence generator, replacing Mongo's `Counter` collection +
/// `findOneAndUpdate({ $inc })` pattern (see lib/receipt.ts). `key` holds the
/// full sequence key (e.g. "REC-20241118" / "INV-20241118"); the counter is
/// scoped per tenant via the unique [tenantId, key] pair, and incremented
/// atomically with `prisma.counter.upsert(... { increment: 1 } ...)`, which
/// Postgres executes as a single atomic UPSERT (no read-then-write race).
model Counter {
  id       String @id
  tenantId String
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("counters")
}

/// Ephemeral in-progress POS cart/session state, replacing the inline Mongo
/// `PosSession` model previously defined directly in
/// app/api/pos/session/[sessionId]/route.ts (TTL-indexed, 1hr expiry).
/// Postgres has no native TTL equivalent to Mongo's `expireAfterSeconds` — a
/// scheduled cleanup job (e.g. extend lib/automations/ similar to the
/// existing audit-log cleanup automation) must periodically run
/// `DELETE FROM pos_sessions WHERE expires_at < now()` since rows are not
/// auto-purged here.
model PosSession {
  id            String   @id
  sessionId     String   @unique
  /// NOT a Tenant.id FK — mirrors the Mongoose model exactly: the client
  /// passes the tenant *slug* from the `[tenant]` route segment here (see
  /// useCustomerDisplaySession.ts / app/[tenant]/[lang]/page.tsx), not the
  /// tenant's ObjectId/UUID, so this stays a plain indexed string column.
  tenant        String
  cart          Json     @default("[]")
  subtotal      Decimal  @default(0) @db.Decimal(18, 2)
  discount      Json?
  taxAmount     Decimal? @db.Decimal(18, 2)
  taxRate       Decimal? @db.Decimal(5, 2)
  taxLabel      String?
  tip           Decimal  @default(0) @db.Decimal(18, 2)
  total         Decimal  @default(0) @db.Decimal(18, 2)
  paymentMethod String?
  paymentStatus String   @default("pending")
  lastUpdate    DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenant])
  @@index([expiresAt])
  @@map("pos_sessions")
}

/// JWT token blacklist (logout / compromise revocation). Global, not tenant-scoped
/// — tokenHash is a truncated SHA-256 of the raw JWT. Postgres has no native TTL;
/// expired rows need the same scheduled-cleanup treatment as AuditLog/PosSession.
model RevokedToken {
  id        String   @id
  tokenHash String   @unique
  reason    String   @default("logout")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// Per-user "revoke all tokens issued before this timestamp" marker, set on
/// password change / forced logout. Global, not tenant-scoped.
model UserRevocation {
  id            String   @id
  userId        String   @unique
  revokedBefore DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_revocations")
}


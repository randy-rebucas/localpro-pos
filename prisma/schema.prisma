}

// ─── Phase 5: transactional / POS core ──────────────────────────────────────

model Customer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  email                String?
  phone                String?
  // Fixed-shape, always read/written atomically with the customer — jsonb array.
  addresses            Json      @default("[]")
  dateOfBirth          DateTime? @map("date_of_birth")
  notes                String?
  tags                 String[]  @default([])
  totalSpent           Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  lastPurchaseDate     DateTime? @map("last_purchase_date")
  loyaltyPointsBalance Int       @default(0) @map("loyalty_points_balance")
  accountBalance       Decimal   @default(0) @map("account_balance") @db.Decimal(14, 2)
  creditLimit          Decimal?  @map("credit_limit") @db.Decimal(14, 2)
  shopifyCustomerId    String?   @map("shopify_customer_id")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  balancePayments     CustomerBalancePayment[]
  transactions        Transaction[]
  invoices            Invoice[]
  offlineTransactions OfflineTransaction[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, isActive])
  @@index([tenantId, shopifyCustomerId])
  @@index([tenantId, tags])
  @@map("customers")
}

// No TTL in Postgres — a scheduled cleanup job must purge expired OTPs
// explicitly (Mongo relied on an `expireAfterSeconds: 0` TTL index here).
model CustomerOTP {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  phone     String
  otp       String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone])
  @@index([tenantId, phone, verified])
  @@index([expiresAt])
  @@map("customer_otps")
}

model CustomerBalancePayment {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  amount     Decimal              @db.Decimal(12, 2)
  method     BalancePaymentMethod
  notes      String?
  recordedBy String?              @map("recorded_by") @db.Uuid
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedByUser User?    @relation(fields: [recordedBy], references: [id])

  @@index([tenantId, customerId, createdAt(sort: Desc)])
  @@map("customer_balance_payments")
}

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  customerName       String        @map("customer_name")
  customerEmail      String?       @map("customer_email")
  customerPhone      String?       @map("customer_phone")
  serviceName        String        @map("service_name")
  serviceDescription String?       @map("service_description")
  startTime          DateTime      @map("start_time")
  endTime            DateTime      @map("end_time")
  duration           Int
  status             BookingStatus @default(pending)
  staffId            String?       @map("staff_id") @db.Uuid
  staffName          String?       @map("staff_name")
  notes              String?
  reminderSent       Boolean       @default(false) @map("reminder_sent")
  confirmationSent   Boolean       @default(false) @map("confirmation_sent")
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  User?  @relation("BookingStaff", fields: [staffId], references: [id])

  @@index([tenantId, startTime])
  @@index([tenantId, staffId, startTime])
  @@index([startTime, endTime])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("bookings")
}

model RecurringBookingTemplate {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  customerName       String         @map("customer_name")
  customerEmail      String?        @map("customer_email")
  customerPhone      String?        @map("customer_phone")
  serviceName        String         @map("service_name")
  serviceDescription String?        @map("service_description")
  staffId            String?        @map("staff_id") @db.Uuid
  staffName          String?        @map("staff_name")
  duration           Int
  startTimeHour      Int            @map("start_time_hour")
  startTimeMinute    Int            @map("start_time_minute")
  recurrenceType     RecurrenceType @map("recurrence_type")
  daysOfWeek         Int[]          @default([]) @map("days_of_week")
  dayOfMonth         Int?           @map("day_of_month")
  effectiveFrom      DateTime       @map("effective_from")
  effectiveTo        DateTime?      @map("effective_to")
  notes              String?
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  User?  @relation("RecurringBookingTemplateStaff", fields: [staffId], references: [id])

  @@index([tenantId, isActive])
  @@index([tenantId, staffId, isActive])
  @@index([tenantId, recurrenceType, isActive])
  @@map("recurring_booking_templates")
}

model Prescription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  prescriptionNumber String             @map("prescription_number")
  patientName        String             @map("patient_name")
  patientAge         Int?               @map("patient_age")
  doctorName         String             @map("doctor_name")
  doctorPRCNumber    String             @map("doctor_prc_number")
  doctorClinic       String?            @map("doctor_clinic")
  issuedDate         DateTime           @map("issued_date")
  validUntil         DateTime           @map("valid_until")
  transactionId      String?            @map("transaction_id") @db.Uuid
  status             PrescriptionStatus @default(pending)
  notes              String?
  scannedCopy        String?            @map("scanned_copy")
  createdBy          String             @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id])
  createdByUser User               @relation("PrescriptionCreatedBy", fields: [createdBy], references: [id])
  items         PrescriptionItem[]

  @@unique([tenantId, prescriptionNumber])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, validUntil])
  @@map("prescriptions")
}

// Decomposed from Prescription.items[] because each item has its own FKs
// (Product, dispensing User, the Transaction it was dispensed against) and
// items are dispensed individually, not as a single atomic unit.
model PrescriptionItem {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionId         String    @map("prescription_id") @db.Uuid
  productId              String?   @map("product_id") @db.Uuid
  drugName               String    @map("drug_name")
  quantity               Int
  dosage                 String
  frequency              String
  instructions           String?
  dispensed              Boolean   @default(false)
  dispensedAt            DateTime? @map("dispensed_at")
  dispensedBy            String?   @map("dispensed_by") @db.Uuid
  dispensedTransactionId String?   @map("dispensed_transaction_id") @db.Uuid

  prescription         Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product              Product?     @relation(fields: [productId], references: [id])
  dispensedByUser      User?        @relation("PrescriptionItemDispensedBy", fields: [dispensedBy], references: [id])
  dispensedTransaction Transaction? @relation("PrescriptionItemDispensedTransaction", fields: [dispensedTransactionId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_items")
}

model SavedCart {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @default("Saved Cart")
  // Snapshot of cart contents at save time — not reporting-critical, no
  // independent aggregation, always read/written atomically. jsonb.
  items          Json
  subtotal       Decimal  @db.Decimal(12, 2)
  discountCode   String?  @map("discount_code")
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  userId         String   @map("user_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, name])
  @@map("saved_carts")
}

model CashDrawerSession {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  openingAmount  Decimal          @map("opening_amount") @db.Decimal(12, 2)
  closingAmount  Decimal?         @map("closing_amount") @db.Decimal(12, 2)
  expectedAmount Decimal?         @map("expected_amount") @db.Decimal(12, 2)
  shortage       Decimal?         @db.Decimal(12, 2)
  overage        Decimal?         @db.Decimal(12, 2)
  openingTime    DateTime         @default(now()) @map("opening_time")
  closingTime    DateTime?        @map("closing_time")
  status         CashDrawerStatus @default(open)
  notes          String?
  totalVAT       Decimal          @default(0) @map("total_vat") @db.Decimal(12, 2)
  totalDiscounts Decimal          @default(0) @map("total_discounts") @db.Decimal(12, 2)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, openingTime(sort: Desc)])
  @@map("cash_drawer_sessions")
}

model Transaction {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  branchId              String?                  @map("branch_id") @db.Uuid
  subtotal              Decimal                  @db.Decimal(12, 2)
  discountCode          String?                  @map("discount_code")
  discountCategory      DiscountCategory?        @map("discount_category")
  discountAmount        Decimal?                 @map("discount_amount") @db.Decimal(12, 2)
  scPwdName             String?                  @map("sc_pwd_name")
  scPwdId               String?                  @map("sc_pwd_id")
  taxExemptAmount       Decimal                  @default(0) @map("tax_exempt_amount") @db.Decimal(12, 2)
  zeroRatedAmount       Decimal                  @default(0) @map("zero_rated_amount") @db.Decimal(12, 2)
  taxAmount             Decimal                  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total                 Decimal                  @db.Decimal(12, 2)
  paymentMethod         TransactionPaymentMethod @map("payment_method")
  paymentProvider       String?                  @map("payment_provider")
  paymentReference      String?                  @map("payment_reference")
  bnplInstallments      Int?                     @map("bnpl_installments")
  cashReceived          Decimal?                 @map("cash_received") @db.Decimal(12, 2)
  change                Decimal?                 @db.Decimal(12, 2)
  status                TransactionStatus        @default(completed)
  customerId            String?                  @map("customer_id") @db.Uuid
  loyaltyPointsEarned   Int?                     @map("loyalty_points_earned")
  loyaltyPointsRedeemed Int?                     @map("loyalty_points_redeemed")
  userId                String?                  @map("user_id") @db.Uuid
  deviceId              String?                  @map("device_id") @db.Uuid
  terminalId            String?                  @map("terminal_id")
  deviceSerialNumber    String?                  @map("device_serial_number")
  receiptNumber         String?                  @map("receipt_number")
  notes                 String?
  displayCurrency       String?                  @map("display_currency")
  displayTotal          Decimal?                 @map("display_total") @db.Decimal(12, 2)
  orderType             OrderType?               @map("order_type")
  tableNumber           String?                  @map("table_number")
  tableId               String?                  @map("table_id") @db.Uuid
  splitCount            Int?                     @map("split_count")
  salesChannel          SalesChannel?            @map("sales_channel")
  externalOrderId       String?                  @map("external_order_id")
  channelSyncKey        String?                  @map("channel_sync_key")
  channelImportedAt     DateTime?                @map("channel_imported_at")
  shopifyFulfilledAt    DateTime?                @map("shopify_fulfilled_at")
  shopifyFulfillmentId  String?                  @map("shopify_fulfillment_id")
  isActive              Boolean                  @default(true) @map("is_active")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User?     @relation("TransactionUser", fields: [userId], references: [id])
  device   Device?   @relation(fields: [deviceId], references: [id])
  table    Table?    @relation("TransactionTable", fields: [tableId], references: [id])

  items                         TransactionItem[]
  splitPayments                 TransactionSplitPayment[]
  payments                      Payment[]
  invoices                      Invoice[]
  stockMovements                StockMovement[]
  prescriptions                 Prescription[]
  dispensedPrescriptionItems    PrescriptionItem[]        @relation("PrescriptionItemDispensedTransaction")
  currentForTables              Table[]                   @relation("TableCurrentOrder")
  syncedFromOfflineTransactions OfflineTransaction[]      @relation("OfflineTransactionSynced")
  loyaltyTransactions           LoyaltyTransaction[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, channelSyncKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, branchId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, isActive, createdAt(sort: Desc)])
  @@map("transactions")
}

// Decomposed from Transaction.items[] — joined/aggregated in reporting and
// FKs to Product/Prescription.
model TransactionItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId  String  @map("transaction_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  name           String
  price          Decimal @db.Decimal(12, 2)
  quantity       Int
  subtotal       Decimal @db.Decimal(12, 2)
  // [{ name, chosenOption, price }] — low cardinality, read/written atomically with the item.
  modifiers      Json?
  prescriptionId String? @map("prescription_id") @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

// Decomposed from Transaction.splitPayments[] — reconciliation queries need
// to sum/filter by paymentMethod across split payments.
model TransactionSplitPayment {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String  @map("transaction_id") @db.Uuid
  guestIndex    Int     @map("guest_index")
  method        String
  amount        Decimal @db.Decimal(12, 2)
  reference     String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_split_payments")
}

model Payment {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  transactionId String              @map("transaction_id") @db.Uuid
  method        PaymentRecordMethod
  amount        Decimal             @db.Decimal(12, 2)
  status        PaymentRecordStatus @default(pending)
  // { cardLast4?, cardType?, cardBrand?, transactionId?, provider?, cashReceived?, change?, checkNumber?, notes? }
  details       Json?
  processedBy   String?             @map("processed_by") @db.Uuid
  processedAt   DateTime?           @map("processed_at")
  refundedAt    DateTime?           @map("refunded_at")
  refundReason  String?             @map("refund_reason")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  processedByUser User?       @relation(fields: [processedBy], references: [id])

  @@index([tenantId, transactionId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, method, createdAt(sort: Desc)])
  @@index([tenantId, status, method, createdAt(sort: Desc)])
  @@index([processedBy, createdAt(sort: Desc)])
  @@index([tenantId, isActive])
  @@map("payments")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")
  transactionId  String?       @map("transaction_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  // Snapshot of customer info at invoice creation — { name, email?, phone?, address? }
  customerInfo   Json?         @map("customer_info")
  // [{ name, description?, quantity, price, subtotal }] — line-item snapshot, not live products.
  items          Json
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal?      @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  dueDate        DateTime      @map("due_date")
  paymentTerms   String?       @map("payment_terms")
  status         InvoiceStatus @default(draft)
  paidAt         DateTime?     @map("paid_at")
  paidAmount     Decimal?      @map("paid_amount") @db.Decimal(12, 2)
  notes          String?
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, transactionId])
  @@index([tenantId, isActive])
  @@map("invoices")
}

model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  branchId      String?           @map("branch_id") @db.Uuid
  // { size?, color?, type? } — small, fixed-shape.
  variation     Json?
  type          StockMovementType
  quantity      Int
  previousStock Int               @map("previous_stock")
  newStock      Int               @map("new_stock")
  reason        String?
  transactionId String?           @map("transaction_id") @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?      @relation(fields: [branchId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([tenantId, productId, createdAt(sort: Desc)])
  @@index([tenantId, branchId, productId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("stock_movements")
}

model Expense {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  name          String
  description   String
  amount        Decimal              @db.Decimal(12, 2)
  date          DateTime             @default(now())
  paymentMethod ExpensePaymentMethod @map("payment_method")
  receipt       String?
  notes         String?
  userId        String               @map("user_id") @db.Uuid
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, date(sort: Desc)])
  @@index([tenantId, name])
  @@index([tenantId, isActive])

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalVariantId])
  @@index([tenantId, productId, provider])
  @@map("product_channel_listings")
}

model Discount {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  code                   String
  name                   String?
  description            String?
  type                   DiscountValueType
  value                  Decimal           @db.Decimal(7, 2)
  category               DiscountCategory  @default(general)
  requiresIdVerification Boolean           @default(false) @map("requires_id_verification")
  minPurchaseAmount      Decimal?          @map("min_purchase_amount") @db.Decimal(12, 2)
  maxDiscountAmount      Decimal?          @map("max_discount_amount") @db.Decimal(12, 2)
  validFrom              DateTime          @map("valid_from")
  validUntil             DateTime          @map("valid_until")
  usageLimit             Int?              @map("usage_limit")
  usageCount             Int               @default(0) @map("usage_count")
  isActive               Boolean           @default(true) @map("is_active")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive, validFrom, validUntil])
  @@map("discounts")
}

// Not tenant-scoped — used for subscription-plan billing discounts (super-admin managed).
model Coupon {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String            @unique
  description   String?
  discountType  DiscountValueType @map("discount_type")
  discountValue Decimal           @map("discount_value") @db.Decimal(7, 2)
  appliesTo     CouponAppliesTo   @default(all_plans) @map("applies_to")
  planIds       String[]          @default([]) @map("plan_ids") @db.Uuid
  maxUses       Int?              @map("max_uses")
  usedCount     Int               @default(0) @map("used_count")

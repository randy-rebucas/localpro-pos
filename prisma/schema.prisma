  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  createdByUser User @relation(fields: [createdBy], references: [id])

  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

model LoyaltyConfig {

// Records the deterministic ObjectId -> UUID mapping used across the export/
// transform/import pipeline so every FK reference resolves consistently and
// re-runs are idempotent. See scripts/migrations/02-id-map.ts.
model MigrationIdMap {
  collection String   @db.VarChar(64)
  mongoId    String   @map("mongo_id") @db.VarChar(24)
  uuid       String   @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([collection, mongoId])
  @@unique([uuid])
  @@map("_migration_id_map")
}

model Tenant {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                       String           @unique
  name                       String
  domain                     String?          @unique
  subdomain                  String?          @unique
  settings                   Json             @default("{}")
  isActive                   Boolean          @default(true) @map("is_active")
  onboardingStatus           OnboardingStatus @default(not_started) @map("onboarding_status")
  notes                      String?
  createdBy                  String?          @map("created_by") @db.Uuid
  grandTotalSales            Decimal          @default(0) @map("grand_total_sales") @db.Decimal(14, 2)
  grandTotalTransactionCount Int              @default(0) @map("grand_total_transaction_count")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  createdByUser User? @relation("TenantCreatedBy", fields: [createdBy], references: [id])

  taxRules                  TaxRule[]
  featureFlagOverrides      FeatureFlagOverride[]
  addresses                 Address[]
  files                     File[]
  users                     User[]                       @relation("UserTenant")
  branches                  Branch[]
  devices                   Device[]
  tables                    Table[]
  auditLogs                 AuditLog[]
  archivedAuditLogs         ArchivedAuditLog[]
  categories                Category[]
  products                  Product[]
  productBundles            ProductBundle[]
  productChannelListings    ProductChannelListing[]
  discounts                 Discount[]
  loyaltyConfig             LoyaltyConfig?
  campaigns                 Campaign[]
  ecommerceIntegrations     TenantEcommerceIntegration[]
  customers                 Customer[]
  customerOtps              CustomerOTP[]
  customerBalancePayments   CustomerBalancePayment[]
  bookings                  Booking[]
  recurringBookingTemplates RecurringBookingTemplate[]
  prescriptions             Prescription[]
  savedCarts                SavedCart[]
  cashDrawerSessions        CashDrawerSession[]
  transactions              Transaction[]
  payments                  Payment[]
  invoices                  Invoice[]
  stockMovements            StockMovement[]
  expenses                  Expense[]
  offlineTransactions       OfflineTransaction[]
  zReadings                 ZReading[]
  loyaltyTransactions       LoyaltyTransaction[]
  billingEvents             BillingEvent[]
  subscription              Subscription?
  attendances               Attendance[]

  @@map("tenants")
}

model SubscriptionPlan {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  tier                  SubscriptionTier @unique
  description           String?
  priceMonthly          Decimal          @map("price_monthly") @db.Decimal(10, 2)
  priceSetupFee         Decimal          @default(0) @map("price_setup_fee") @db.Decimal(10, 2)
  priceCurrency         String           @default("PHP") @map("price_currency")
  reactivationFee       Decimal          @default(500) @map("reactivation_fee") @db.Decimal(10, 2)
  features              Json             @default("{}")
  birCompliance         Json             @default("{}") @map("bir_compliance")
  pharmacyCompliance    Json             @default("{}") @map("pharmacy_compliance")
  isActive              Boolean          @default(true) @map("is_active")
  isCustom              Boolean          @default(false) @map("is_custom")
  availableToNewTenants Boolean          @default(true) @map("available_to_new_tenants")
  yearlyDiscount        Decimal          @default(0) @map("yearly_discount") @db.Decimal(5, 2)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

model TaxRule {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  rate        Decimal      @db.Decimal(5, 2)
  label       String       @default("Tax")
  appliesTo   TaxAppliesTo @default(all) @map("applies_to")
  categoryIds String[]     @default([]) @map("category_ids") @db.Uuid
  productIds  String[]     @default([]) @map("product_ids") @db.Uuid
  region      Json?
  priority    Int          @default(0)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, priority(sort: Desc)])
  @@index([tenantId, appliesTo, isActive])
  @@map("tax_rules")
}

model FeatureFlagOverride {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  feature   String
  enabled   Boolean
  reason    String?
  expiresAt DateTime? @map("expires_at")
  grantedBy String    @map("granted_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantedByUser User   @relation(fields: [grantedBy], references: [id])

  @@unique([tenantId, feature])
  @@index([expiresAt])
  @@map("feature_flag_overrides")
}

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String   @default("Home")
  street    String
  city      String
  state     String?
  zipCode   String?  @map("zip_code")
  country   String
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@map("addresses")
}

model File {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  filename   String
  size       Int
  type       String
  url        String
  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId, uploadedAt(sort: Desc)])
  @@map("files")
}

// ─── Phase 3: auth / tenant core ────────────────────────────────────────────

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  password  String
  name      String
  role      Role      @default(cashier)
  tenantId  String?   @map("tenant_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  qrToken   String?   @unique @map("qr_token")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant? @relation("UserTenant", fields: [tenantId], references: [id])
  branch Branch? @relation("UserBranch", fields: [branchId], references: [id])

  createdTenants                 Tenant[]                   @relation("TenantCreatedBy")
  managedBranches                Branch[]                   @relation("BranchManager")
  registeredDevices              Device[]                   @relation("DeviceRegisteredBy")
  addresses                      Address[]
  uploadedFiles                  File[]
  grantedFeatureFlags            FeatureFlagOverride[]
  auditLogs                      AuditLog[]
  archivedAuditLogs              ArchivedAuditLog[]
  superAdminActions              SuperAdminAction[]
  campaigns                      Campaign[]
  coupons                        Coupon[]
  recordedBalancePayments        CustomerBalancePayment[]
  staffBookings                  Booking[]                  @relation("BookingStaff")
  staffRecurringBookingTemplates RecurringBookingTemplate[] @relation("RecurringBookingTemplateStaff")
  createdPrescriptions           Prescription[]             @relation("PrescriptionCreatedBy")
  dispensedPrescriptionItems     PrescriptionItem[]         @relation("PrescriptionItemDispensedBy")
  savedCarts                     SavedCart[]
  cashDrawerSessions             CashDrawerSession[]
  transactions                   Transaction[]              @relation("TransactionUser")
  processedPayments              Payment[]
  stockMovements                 StockMovement[]
  expenses                       Expense[]
  offlineTransactions            OfflineTransaction[]
  generatedZReadings             ZReading[]
  loyaltyTransactionsCreated     LoyaltyTransaction[]
  billingEventsRecorded          BillingEvent[]
  attendances                    Attendance[]
  revocation                     UserRevocation?

  @@unique([tenantId, email])
  @@index([tenantId, role, isActive])
  @@index([tenantId, branchId, isActive])
  @@map("users")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  address   Json?
  phone     String?
  email     String?
  managerId String?  @map("manager_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager             User?                        @relation("BranchManager", fields: [managerId], references: [id])
  users               User[]                       @relation("UserBranch")
  devices             Device[]
  tables              Table[]
  integrations        TenantEcommerceIntegration[]
  productBranchStocks ProductBranchStock[]
  transactions        Transaction[]
  stockMovements      StockMovement[]
  offlineTransactions OfflineTransaction[]
  zReadings           ZReading[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("branches")
}

model Device {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  branchId     String?         @map("branch_id") @db.Uuid
  label        String
  serialNumber String          @map("serial_number")
  terminalId   String          @map("terminal_id")
  ptuNumber    String?         @map("ptu_number")
  ptuStatus    DevicePtuStatus @default(pending) @map("ptu_status")
  isActive     Boolean         @default(true) @map("is_active")
  registeredBy String          @map("registered_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?       @relation(fields: [branchId], references: [id])
  registeredByUser User          @relation("DeviceRegisteredBy", fields: [registeredBy], references: [id])
  transactions     Transaction[]

  @@unique([tenantId, terminalId])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, isActive])
  @@map("devices")
}

model Table {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  branchId       String?     @map("branch_id") @db.Uuid
  name           String
  capacity       Int?
  status         TableStatus @default(open)
  currentOrderId String?     @map("current_order_id") @db.Uuid
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  currentOrder Transaction?  @relation("TableCurrentOrder", fields: [currentOrderId], references: [id])
  transactions Transaction[] @relation("TransactionTable")

  @@unique([tenantId, name])
  @@index([tenantId, isActive, status])
  @@map("tables")
}

model SuperAdminAction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  description String?
  changes     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("super_admin_actions")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Cold-storage copy of expired AuditLog rows. No TTL index in Postgres —
// the app's scheduled cleanup job (app/api/automations/audit-logs/cleanup)
// moves rows here explicitly instead of relying on Mongo's TTL collection.
model ArchivedAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  archivedAt DateTime @default(now()) @map("archived_at")
  createdAt  DateTime @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, archivedAt(sort: Desc)])
  @@map("archived_audit_logs")
}

// ─── Phase 4: catalog / config ──────────────────────────────────────────────

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  bundles  ProductBundle[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Product {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  name                 String
  description          String?
  price                Decimal             @db.Decimal(12, 2)
  // BigInt not Int: 18 real pharmacy products in production have stock
  // values up to ~5x10^14 (clear data-entry bugs, but the migration
  // preserves data faithfully rather than silently truncating it — INT4's
  // ~2.1B ceiling isn't enough).
  stock                BigInt              @default(0)
  sku                  String?
  barcode              String?
  category             String?
  categoryId           String?             @map("category_id") @db.Uuid
  image                String?
  productType          ProductType         @default(regular) @map("product_type")
  hasVariations        Boolean             @default(false) @map("has_variations")
  // Low-cardinality, always read/written atomically with the product — kept as jsonb.
  variations           Json?
  modifiers            Json?
  allergens            String[]            @default([])
  nutritionInfo        Json?               @map("nutrition_info")
  taxExempt            Boolean             @default(false) @map("tax_exempt")
  zeroRated            Boolean             @default(false) @map("zero_rated")
  trackInventory       Boolean             @default(true) @map("track_inventory")
  allowOutOfStockSales Boolean             @default(false) @map("allow_out_of_stock_sales")
  lowStockThreshold    Int?                @map("low_stock_threshold")
  pinned               Boolean             @default(false)
  serviceType          LaundryServiceType? @map("service_type")
  weightBased          Boolean             @default(false) @map("weight_based")
  pickupDelivery       Boolean             @default(false) @map("pickup_delivery")
  estimatedDuration    Int?                @map("estimated_duration")
  serviceDuration      Int?                @map("service_duration")
  staffRequired        Int?                @default(1) @map("staff_required")
  equipmentRequired    String[]            @default([]) @map("equipment_required")
  genericName          String?             @map("generic_name")
  manufacturer         String?
  prn                  String?
  batchNumber          String?             @map("batch_number")
  expiryDate           DateTime?           @map("expiry_date")
  drugSchedule         DrugSchedule?       @map("drug_schedule")
  requiresPrescription Boolean             @default(false) @map("requires_prescription")
  storageConditions    String?             @map("storage_conditions")
  activeIngredient     String?             @map("active_ingredient")
  dosageStrength       String?             @map("dosage_strength")
  dosageForm           String?             @map("dosage_form")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRef       Category?               @relation(fields: [categoryId], references: [id])
  branchStock       ProductBranchStock[]
  channelListings   ProductChannelListing[]
  bundleItems       ProductBundleItem[]
  prescriptionItems PrescriptionItem[]
  transactionItems  TransactionItem[]
  stockMovements    StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productType, trackInventory])
  @@index([tenantId, hasVariations])
  @@index([tenantId, pinned(sort: Desc), createdAt(sort: Desc)])
  @@index([tenantId, expiryDate])
  @@index([tenantId, drugSchedule])
  @@map("products")
}

// Branch-specific stock levels. Decomposed from Product.branchStock[] because
// it has its own FK (Branch) and is queried independently for low-stock
// alerts / per-branch reporting.
model ProductBranchStock {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  stock     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("product_branch_stock")
}

model ProductBundle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  sku            String?
  categoryId     String?  @map("category_id") @db.Uuid
  image          String?
  trackInventory Boolean  @default(true) @map("track_inventory")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRef Category?           @relation(fields: [categoryId], references: [id])
  items       ProductBundleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@map("product_bundles")
}

// Decomposed from ProductBundle.items[] because each item FKs to Product and
// bundle composition needs referential integrity when a Product is deleted/renamed.
model ProductBundleItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId    String @map("bundle_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  productName String @map("product_name")
  quantity    Int
  // { size?, color?, type? } — small, fixed-shape, never queried standalone.
  variation   Json?

  bundle  ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([bundleId])
  @@index([productId])
  @@map("product_bundle_items")
}

model ProductChannelListing {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  provider          EcommerceProvider
  externalProductId String            @map("external_product_id")
  externalVariantId String            @map("external_variant_id")
  inventoryItemId   String?           @map("inventory_item_id")

// ============================================================================
// 1POS — PostgreSQL schema (Phase 1: schema design only, no app code changes)
//
// Conventions
// - Every table's `id` is String and holds the original Mongo ObjectId hex
//   string during ETL (see migration plan Phase 3). Post-migration this can
//   be swapped for native uuid/bigserial — left as `String @id` for now to
//   simplify the one-time data copy, per the agreed plan.
// - Every tenant-scoped table has a required, indexed `tenantId` FK. This is
//   non-negotiable given this codebase's documented cross-tenant leak history.
// - Embedded Mongoose subdocument arrays become child tables with a FK back
//   to the parent (fully normalized — no JSONB dumping grounds), except where
//   explicitly called out as JSONB in the final report (arbitrary/unpredictable
//   shapes only: AuditLog/ArchivedAuditLog/SuperAdminAction/BillingEvent
//   changes+metadata, and Tenant rolePermissionOverrides).
// - Primitive scalar arrays (no nested object, not a relation) are kept as
//   native Postgres arrays (String[] / Int[]) rather than exploded into
//   single-column child tables — e.g. Product.allergens, Customer.tags.
// - Arrays of ObjectId *references* (many-to-many) become join tables.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


;; 1POS PgBouncer — installed by provision.sh to /etc/pgbouncer/pgbouncer.ini
;; Vercel functions connect here (port 6432, TLS required). Postgres itself
;; only listens on localhost.

[databases]
${DB_NAME} = host=127.0.0.1 port=5432 dbname=${DB_NAME}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432

auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt

;; Transaction pooling: many short-lived serverless clients share a few
;; server connections. Session state (SET, advisory locks, LISTEN) must not
;; be relied on outside a transaction — use SET LOCAL.
pool_mode = transaction
max_client_conn = 1000
default_pool_size = 20
reserve_pool_size = 5
reserve_pool_timeout = 3
;; Leave headroom under max_connections = 100 for migrations, ETL, backups
max_db_connections = 60
max_prepared_statements = 200

server_idle_timeout = 300
query_wait_timeout = 30
ignore_startup_parameters = extra_float_digits,options

client_tls_sslmode = require
client_tls_cert_file = /etc/pgbouncer/tls/server.crt
client_tls_key_file = /etc/pgbouncer/tls/server.key
client_tls_protocols = tlsv1.2,tlsv1.3

stats_users = pos_readonly

logfile = /var/log/postgresql/pgbouncer.log
pidfile = /var/run/postgresql/pgbouncer.pid
log_connections = 0
log_disconnections = 0

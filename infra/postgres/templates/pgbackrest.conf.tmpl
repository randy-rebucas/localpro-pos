# 1POS pgBackRest — installed by provision.sh to /etc/pgbackrest/pgbackrest.conf
# Encrypted, compressed backups + continuous WAL archive to the existing
# S3-compatible bucket (BACKUP_S3_*). Enables point-in-time recovery.

[global]
repo1-type=s3
repo1-s3-endpoint=${S3_ENDPOINT}
repo1-s3-region=${S3_REGION}
repo1-s3-bucket=${S3_BUCKET}
repo1-s3-key=${S3_ACCESS_KEY_ID}
repo1-s3-key-secret=${S3_SECRET_ACCESS_KEY}
repo1-s3-uri-style=${S3_URI_STYLE}
repo1-path=/pgbackrest/1pos
repo1-retention-full=4
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${BACKUP_CIPHER_PASS}

compress-type=zst
start-fast=y
process-max=2
log-level-console=info
log-level-file=detail

[1pos]
pg1-path=/var/lib/postgresql/17/main

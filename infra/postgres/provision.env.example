# Copy to provision.env (gitignored) and fill in, then: sudo ./provision.sh provision.env

# Public DNS name pointing at the VPS (A record). Used for the TLS certificate.
DB_HOSTNAME=db.example.com
DB_NAME=localpro_pos

# letsencrypt (recommended; clients use sslmode=verify-full) or selfsigned
TLS_MODE=letsencrypt
LETSENCRYPT_EMAIL=ops@example.com

# Who may reach PgBouncer on :6432. "any" is needed for Vercel functions
# (no fixed egress IPs); otherwise a comma-separated list of CIDRs.
PGBOUNCER_ALLOW_FROM=any

# pgBackRest → S3-compatible storage. Same bucket as BACKUP_S3_* in the app is fine;
# backups go under /pgbackrest/1pos. Leave empty to skip (NOT for production).
S3_ENDPOINT=s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# host for AWS S3; path for MinIO / most other S3-compatible providers
S3_URI_STYLE=host
